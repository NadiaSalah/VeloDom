{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    "inlineSources": true,
    "noEmit": false,
    "outDir": "lib",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src/core",
    "sourceMap": true
  },
  "include": [
    "src/core/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "lib",
    "types"
  ]
}
