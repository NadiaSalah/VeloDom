{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "#app/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*.js"
  ]
}
