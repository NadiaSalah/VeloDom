{
  "name": "velodom",
  "private": true,
  "version": "0.1.0",
  "description": "Compiler-first, HTML-first frontend framework with reactive state, routing, components, and requests.",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "files": [
    "lib",
    "types",
    "README.md",
    "CHANGELOG.md",
    "RELEASING.md"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./compiler": {
      "types": "./types/compiler/index.d.ts",
      "import": "./lib/compiler/index.js",
      "default": "./lib/compiler/index.js"
    },
    "./vite": {
      "types": "./types/adapters/vite.d.ts",
      "import": "./lib/adapters/vite.js",
      "default": "./lib/adapters/vite.js"
    },
    "./vite-plugin": {
      "types": "./types/vite-plugin/index.d.ts",
      "import": "./lib/vite-plugin/index.js",
      "default": "./lib/vite-plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check && npm run package:check && vite build",
    "preview": "vite preview",
    "test": "node --test",
    "docs:check": "node scripts/check-core-docs.mjs",
    "typecheck": "tsc --noEmit",
    "clean:types": "node -e \"require('node:fs').rmSync('types', { recursive: true, force: true })\"",
    "clean:package": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "types": "npm run clean:types && tsc --project tsconfig.types.json && node scripts/rewrite-declaration-imports.mjs",
    "package:build": "npm run clean:package && tsc --project tsconfig.package.json && npm run types",
    "package:consumer": "npm run package:build && node scripts/check-package-consumer.mjs",
    "package:check": "npm run package:build && node scripts/check-package.mjs && node scripts/check-package-consumer.mjs",
    "pack:check": "npm pack --dry-run",
    "lint": "eslint .",
    "check": "npm run docs:check && npm run typecheck && npm run lint",
    "prepack": "npm run package:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.1.0",
    "autoprefixer": "^10.5.0",
    "daisyui": "^5.5.19",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3"
  }
}
