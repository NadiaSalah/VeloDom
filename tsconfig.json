{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "velodom": [
        "./packages/velodom/src/index.ts"
      ],
      "velodom/vite": [
        "./packages/velodom/src/adapters/vite.ts"
      ],
      "velodom/vite-plugin": [
        "./packages/velodom/src/vite-plugin/index.ts"
      ],
      "@/*": [
        "./examples/blog/src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "vite/client"
    ],
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": false,
    "noImplicitOverride": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/velodom/src/**/*.ts",
    "examples/blog/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples/blog/dist",
    "packages/velodom/lib",
    "packages/velodom/types"
  ]
}
