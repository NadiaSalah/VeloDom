{
  "extends": "./packages/velodom/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "velodom": [
        "./packages/velodom/src/index.ts"
      ],
      "velodom/vite": [
        "./packages/velodom/src/adapters/vite.ts"
      ],
      "velodom/vite-plugin": [
        "./packages/velodom/src/vite-plugin/index.ts"
      ],
      "@/*": [
        "./examples/velodom-blog/src/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "packages/velodom/src/**/*.ts",
    "examples/velodom-blog/src/**/*.ts",
    "tools/type-tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples/velodom-blog/dist",
    "packages/velodom/lib",
    "packages/velodom/types"
  ]
}
