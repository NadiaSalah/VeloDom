{
  "name": "velodom",
  "private": true,
  "version": "1.0.0",
  "description": "Compiler-first, HTML-first frontend framework with reactive state, routing, components, and requests.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NadiaSalah/velodom.git"
  },
  "bugs": {
    "url": "https://github.com/NadiaSalah/velodom/issues"
  },
  "homepage": "https://github.com/NadiaSalah/velodom#readme",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "bin": {
    "vd": "./bin/vd.js",
    "create-velodom": "./bin/create-velodom.js"
  },
  "files": [
    "bin",
    "lib",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 Android versions",
    "not dead",
    "not op_mini all"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./compiler": {
      "types": "./types/compiler/index.d.ts",
      "import": "./lib/compiler/index.js",
      "default": "./lib/compiler/index.js"
    },
    "./content": {
      "types": "./types/content.d.ts",
      "import": "./lib/content.js",
      "default": "./lib/content.js"
    },
    "./assets": {
      "types": "./types/assets.d.ts",
      "import": "./lib/assets.js",
      "default": "./lib/assets.js"
    },
    "./devtools": {
      "types": "./types/devtools.d.ts",
      "import": "./lib/devtools.js",
      "default": "./lib/devtools.js"
    },
    "./vite": {
      "types": "./types/adapters/vite.d.ts",
      "import": "./lib/adapters/vite.js",
      "default": "./lib/adapters/vite.js"
    },
    "./vite-plugin": {
      "types": "./types/vite-plugin/index.d.ts",
      "import": "./lib/vite-plugin/index.js",
      "default": "./lib/vite-plugin/index.js"
    },
    "./testing": {
      "types": "./types/testing.d.ts",
      "import": "./lib/testing.js",
      "default": "./lib/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean:types": "node -e \"require('node:fs').rmSync('types', { recursive: true, force: true })\"",
    "clean:package": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "types": "npm run clean:types && tsc --project ../../tsconfig.types.json && node ../../scripts/rewrite-declaration-imports.mjs",
    "package:build": "npm run clean:package && tsc --project ../../tsconfig.package.json && npm run types",
    "package:consumer": "npm run package:build && node ../../scripts/check-package-consumer.mjs",
    "package:check": "npm run package:build && node ../../scripts/check-package.mjs && node ../../scripts/check-package-consumer.mjs",
    "pack:check": "npm run package:check && node ../../scripts/check-pack-dry-run.mjs",
    "prepack": "npm run package:check"
  },
  "peerDependencies": {
    "typescript": ">=5.7",
    "vite": ">=6 <9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
